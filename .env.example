# The application reads OS environment variables. This file is a reference, not auto-loaded.
APP_ENV=development
DATABASE_PATH=data/harbor.db
DEMO_MODE=true
# Required in production, at least 16 characters. No default production password.
ADMIN_PASSWORD=
COOKIE_SECURE=false
SESSION_HOURS=8
# Optional local model; rules and retrieval work without it.
OLLAMA_URL=
OLLAMA_MODEL=qwen3:8b
# Optional inbound Shopify integration, one configured tenant/shop per deployment.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_TENANT_ID=harbor
